cc_binary {
    name: "android.hardware.camera.provider-service.lge",
    vintf_fragments: ["android.hardware.camera.provider-service.lge.xml"],
    init_rc: ["android.hardware.camera.provider-service.lge.rc"],
    srcs: [
        "service.cpp",
        "LgeCameraProvider.cpp",
    ],
    shared_libs: [
        "android.hardware.camera.common-V1-ndk",
        "android.hardware.camera.device-V1-ndk",
        "android.hardware.camera.provider-V1-ndk",
        "camera.device-impl.lineage",
        "libbase",
        "libbinder_ndk",
        "libcamera_metadata",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "android.hardware.camera.common-helper",
        "libaidlcommonsupport",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    proprietary: true,
    relative_install_path: "hw",
}
