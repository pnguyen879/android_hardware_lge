hidl_package_root {
    name: "vendor.lge",
    path: "hardware/lge/interfaces/lge",
}

aidl_interface {
    name: "vendor.lge.hardware.dualscreen",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/vendor/lge/hardware/dualscreen/*.aidl",
    ],
    stability: "vintf",
    owner: "lineage",

    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "system_current",
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
