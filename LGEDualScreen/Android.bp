android_app {
    name: "LGEDualScreen",

    srcs: ["src/**/*.kt"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "vendor.lge.hardware.dualscreen-V1-java",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },
}
